# Base URL for the API server. In local dev this points at the
# node server started with `cd api && npm start` (port 4010). In
# staging / production this is the App Runner URL and is set via
# the deploy pipeline's environment config, not this file.
VITE_API_BASE_URL=http://localhost:4010

# Mapbox credentials for the map component. Create a free token at
# https://account.mapbox.com/access-tokens/ and paste it below. The
# style URL is optional — a default is provided by mapbox-gl if
# empty. Leave both blank to disable the map. VITE_MAPBOX_TOKEN is
# read by the client runtime (MapBox.svelte); PUBLIC_MAPBOX_TOKEN is
# read at build time by SvelteKit to substitute the <link rel=preload>
# in app.html. Set both to the same token value.
VITE_MAPBOX_TOKEN=
PUBLIC_MAPBOX_TOKEN=
VITE_MAPBOX_STYLE_LIGHT=
